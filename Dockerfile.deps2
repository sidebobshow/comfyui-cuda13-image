FROM runpod/comfyui:cuda13.0

# Fix python command (same as deps1/basefix)
RUN ln -s /usr/bin/python3 /usr/local/bin/python

# System deps:
# - libsndfile1: required by python "soundfile" (MMAudio)
# - zstd: required by ollama installer on your image
RUN apt-get update && apt-get install -y --no-install-recommends \
      libsndfile1 \
      zstd \
    && rm -rf /var/lib/apt/lists/*

# Python deps
RUN python -m pip install --no-cache-dir -U pip setuptools wheel \
 && python -m pip install --no-cache-dir soundfile torchdiffeq

# Install Ollama into the image (so it doesn't need reinstalling each pod start)
RUN curl -fsSL https://ollama.com/install.sh | sh
